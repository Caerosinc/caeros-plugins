{
  "apps": [
    {
      "slug": "gmail",
      "name": "Gmail",
      "description": "Connect Gmail once for scoped actions, mailbox sync, managed-agent events, and MCP tools.",
      "logo_url": "https://www.gstatic.com/images/branding/productlogos/gmail_2026/v1/192px.svg",
      "provider": "nango",
      "required": true,
      "tools": [
        "get-attachment",
        "create-draft",
        "get-draft",
        "list-drafts",
        "send-draft",
        "update-draft",
        "get-label",
        "list-labels",
        "get-message",
        "list-messages",
        "modify-message",
        "send-message",
        "trash-message",
        "untrash-message",
        "get-thread",
        "list-threads",
        "modify-thread",
        "trash-thread",
        "untrash-thread"
      ],
      "policy": {
        "get-*": "allow",
        "list-*": "allow",
        "create-draft": "allow",
        "update-draft": "allow",
        "modify-*": "ask_first",
        "send-*": "ask_first",
        "trash-*": "ask_first",
        "untrash-*": "ask_first"
      },
      "integration": {
        "id": "google-mail",
        "mcp": true,
        "syncs": [
          {
            "name": "messages",
            "models": ["GmailMessage"],
            "destination": "conare",
            "container": "connector:gmail",
            "autoStart": false
          },
          {
            "name": "threads",
            "models": ["GmailThread"],
            "destination": "conare",
            "container": "connector:gmail",
            "autoStart": false
          },
          {
            "name": "labels",
            "models": ["GmailLabel"],
            "destination": "conare",
            "container": "connector:gmail",
            "autoStart": false
          }
        ],
        "webhooks": [
          {
            "event": "forward",
            "trigger": "GMAIL_MAILBOX_CHANGED"
          },
          {
            "event": "sync:messages",
            "trigger": "GMAIL_NEW_EMAIL"
          }
        ]
      }
    }
  ]
}
